#!/bin/bash
# pre-push hook — Radiant Play maintainer safety net
#
# Two responsibilities:
#   1. Protect the maintainer working branch 'faris': refuse force-pushes and
#      deletions on any remote. faris is real history (it replaced the old
#      personal branch + force-reset mirror pair), so a non-fast-forward push
#      would drop commits on the remote.
#   2. Remind on pushes to main if platformVersion.ts wasn't bumped.
#
# Install once: bash internal/scripts/install-maintainer-hooks.sh

PLATFORM_VERSION_FILE="src/data/platformVersion.ts"
RELEASE_SCRIPT="internal/scripts/release.sh"

remote_name="$1"
remote_url="$2"

# Detect whether this push targets galaxy
is_galaxy_push=false
if [[ "$remote_name" == "galaxy" ]] || [[ "$remote_url" == *"galaxy.corp.thoughtspot.com"* ]]; then
  is_galaxy_push=true
fi

# Read push refs from stdin (format: <local-ref> <local-sha> <remote-ref> <remote-sha>)
while read local_ref local_sha remote_ref remote_sha; do

  branch="${local_ref#refs/heads/}"
  remote_branch="${remote_ref#refs/heads/}"

  # ── Protect faris: no force-push, no deletion ─────────────────────────────
  if [[ "$remote_branch" == "faris" ]]; then
    zero="0000000000000000000000000000000000000000"
    if [[ "$local_sha" == "$zero" ]]; then
      echo ""
      echo "Refusing to delete 'faris' on $remote_name."
      echo "faris is the maintainer working branch, not a disposable mirror."
      echo ""
      exit 1
    fi
    if [[ "$remote_sha" != "$zero" ]] \
       && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo ""
      echo "Refusing non-fast-forward push to 'faris' on $remote_name."
      echo ""
      echo "faris is real history now (it replaced the old personal branch and its"
      echo "force-reset mirror). Rewriting it would drop commits on the remote."
      echo "Integrate first, then push normally:"
      echo "  git pull --rebase $remote_name faris"
      echo ""
      echo "To bypass this hook (you almost never want to):"
      echo "  git push --no-verify $remote_name faris"
      echo ""
      exit 1
    fi
  fi

  # ── Soft reminder on main pushes without a version bump ───────────────────
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    if git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null | grep -q "$PLATFORM_VERSION_FILE"; then
      echo "✓ platformVersion.ts updated — release looks good. Pushing to main."
    else
      echo ""
      echo "⚠️  Pushing to main without a version bump."
      echo "   platformVersion.ts was not changed in these commits."
      echo ""
      echo "   If this is a release, run: bash $RELEASE_SCRIPT"
      echo "   To push anyway:           git push --no-verify"
      echo ""
    fi
  fi

done

exit 0
