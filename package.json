{
  "name": "radiantplay",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cp docs/collaboration/cursor-to-claude-setup.html public/cursor-to-claude-setup.html && concurrently --kill-others --names \"vite,feedback\" --prefix-colors \"cyan,magenta\" \"vite\" \"python3 feedback/server.py\"",
    "build": "cp docs/collaboration/cursor-to-claude-setup.html public/cursor-to-claude-setup.html && vite build",
    "build:strict": "cp docs/collaboration/cursor-to-claude-setup.html public/cursor-to-claude-setup.html && tsc && node scripts/radiance/check.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "new-prototype": "node scripts/create-prototype.js",
    "sync-icons": "node scripts/sync-icons-from-figma.mjs",
    "sync-icons:dry": "node scripts/sync-icons-from-figma.mjs --dry-run",
    "figma-tokens:diff": "node scripts/figma-tokens/diff.mjs",
    "figma-tokens:pull-styles": "node scripts/figma-tokens/pull-styles.mjs",
    "scaligent-tokens:tally": "node scripts/scaligent-tokens/tally.mjs",
    "scan:dark": "node scripts/radiant-check/scan.mjs",
    "lint:tokens": "node scripts/radiant-check/scan.mjs --strict src/components src/spotter src/prototypes/_shared",
    "thumbnails": "node scripts/thumbnails/capture.mjs",
    "thumbnails:setup": "bash scripts/thumbnails/setup.sh",
    "thumbnails:check": "node scripts/thumbnails/check.mjs",
    "migrate:codemod": "node scripts/radiant-check/codemod.mjs",
    "codemod:check": "node scripts/radiant-check/codemod-check.mjs",
    "migrate:light-only": "node scripts/radiant-check/light-only.mjs",
    "radiance:update": "node scripts/radiance/update.mjs",
    "radiance:check": "node scripts/radiance/check.mjs",
    "radiance:lint": "node scripts/radiance/lint.mjs",
    "handoff": "node internal/scripts/handoff-export.mjs",
    "spec:hash": "node scripts/spec/prototype-hash.mjs"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "prototyping",
    "thoughtspot",
    "radiant"
  ],
  "author": "Faris",
  "license": "ISC",
  "description": "RadiantPlay - AI-assisted interactive prototype builder using ThoughtSpot's design system",
  "repository": {
    "type": "git",
    "url": "https://github.com/faris-ts/radiantplay.git"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev45.0",
    "@glideapps/glide-data-grid": "6.0.4-alpha24",
    "@uiw/react-codemirror": "^4.25.10",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lodash": "4.18.1",
    "marked": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-responsive-carousel": "3.2.23",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
