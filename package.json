{
  "name": "radiantplay",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:strict": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "new-prototype": "node scripts/create-prototype.js",
    "sync-icons": "node scripts/sync-icons-from-figma.mjs",
    "sync-icons:dry": "node scripts/sync-icons-from-figma.mjs --dry-run",
    "figma-tokens:diff": "node scripts/figma-tokens/diff.mjs",
    "figma-tokens:pull-styles": "node scripts/figma-tokens/pull-styles.mjs"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "prototyping",
    "thoughtspot",
    "radiant"
  ],
  "author": "Faris",
  "license": "ISC",
  "description": "RadiantPlay - AI-assisted interactive prototype builder using ThoughtSpot's design system",
  "repository": {
    "type": "git",
    "url": "https://github.com/faris-ts/radiantplay.git"
  },
  "dependencies": {
    "@vercel/speed-insights": "^1.3.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "baseline-browser-mapping": "^2.9.19",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
